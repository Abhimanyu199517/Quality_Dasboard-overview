/* =====================================================
   GENERAL HELPERS
   ===================================================== */

function normalizeHeader_(value) {
  return String(value || '').trim().replace(/\s+/g, ' ').toLowerCase();
}

function normalizeRole_(value) {
  return String(value || '').trim().toUpperCase();
}

function normalizeEmail_(value) {
  return String(value || '').trim().toLowerCase();
}

function firstNonBlank_(values) {
  for (let i = 0; i < values.length; i++) {
    if (values[i] !== null && typeof values[i] !== 'undefined' && String(values[i]).trim() !== '') {
      return values[i];
    }
  }
  return '';
}

function isBlankRow_(row) {
  return row.every(function(value) {
    return value === '' || value === null || typeof value === 'undefined';
  });
}

function formatCellValue_(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    if (isNaN(value.getTime())) return '';
    return Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss');
  }
  if (typeof value === 'number') return value;
  return String(value == null ? '' : value);
}

function parseScore_(value) {
  if (value === null || typeof value === 'undefined' || value === '') return null;

  const original = String(value).trim();
  let number = parseFloat(original.replace('%', ''));
  if (isNaN(number)) return null;

  if (number >= 0 && number <= 1 && original.indexOf('%') === -1) number *= 100;
  return number;
}

function addUniqueValue_(object, value) {
  const text = String(value || '').trim();
  if (text) object[text] = true;
}

function roundNumber_(number, decimals) {
  const multiplier = Math.pow(10, decimals);
  return Math.round(number * multiplier) / multiplier;
}

