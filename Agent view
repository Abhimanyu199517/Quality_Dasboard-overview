function normalizeDateForFilter_(value) {

  if (
    value === null ||
    typeof value === 'undefined' ||
    value === ''
  ) {
    return '';
  }

  /*
   * Google Sheets Date object.
   */
  if (
    Object.prototype.toString.call(value) === '[object Date]'
  ) {

    if (isNaN(value.getTime())) {
      return '';
    }

    return Utilities.formatDate(
      value,
      Session.getScriptTimeZone(),
      'yyyy-MM-dd'
    );
  }

  const text =
    String(value)
      .trim();

  if (!text) {
    return '';
  }

  /*
   * Format:
   * 3/16/2026
   * 03/16/2026
   */
  let match =
    text.match(
      /^(\d{1,2})\/(\d{1,2})\/(\d{4})/
    );

  if (match) {

    const month =
      ('0' + match[1]).slice(-2);

    const day =
      ('0' + match[2]).slice(-2);

    const year =
      match[3];

    return (
      year +
      '-' +
      month +
      '-' +
      day
    );
  }

  /*
   * Format:
   * 2026-03-16
   * 2026-03-16 00:00:00
   */
  match =
    text.match(
      /^(\d{4})-(\d{1,2})-(\d{1,2})/
    );

  if (match) {

    const year =
      match[1];

    const month =
      ('0' + match[2]).slice(-2);

    const day =
      ('0' + match[3]).slice(-2);

    return (
      year +
      '-' +
      month +
      '-' +
      day
    );
  }

  /*
   * Last attempt:
   * Let JavaScript parse the value.
   */
  const parsed =
    new Date(text);

  if (
    !isNaN(parsed.getTime())
  ) {

    return Utilities.formatDate(
      parsed,
      Session.getScriptTimeZone(),
      'yyyy-MM-dd'
    );

  }

  return '';
}
